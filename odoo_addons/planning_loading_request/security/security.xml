<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_loading" model="ir.module.category">
        <field name="name">Chargements</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_loading_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="module_category_loading"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_loading_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="module_category_loading"/>
        <field name="implied_ids" eval="[(4, ref('group_loading_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="loading_request_company_rule" model="ir.rule">
        <field name="name">Demandes de chargement : multi-société</field>
        <field name="model_id" ref="model_planning_loading_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
